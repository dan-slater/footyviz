    "takedown": "A takedown request removes the match from this manifest and its labels."
  },
  "data_root": "~/footyviz-bench-data",
  "conventions": {
    "window_file": "windows/<eyeball_tier>_<video_id>_<a>-<b>.mp4 (stream copy, starts on the keyframe at or before <a>)",
    "clip_file": "clips/<id>.mp4 (frame-accurate libx264 crf 12 re-encode, audio kept; frame 0 = first frame with source pts >= label_window.start_s)",
    "image_tier": "measured by fv.bench.measure: low if luma < 55 or laplacian_var < 250; mid if luma < 90; else high. Confirmed by eye (eye_note).",
    "kit_tier": "clean = two distinct team kits; bibs = bibs over mixed shirts or one side mixed; none = casual clothes, no team kit",
    "team_norm": "lower-case, scores/dates/punctuation stripped, then aliases applied; train and eval must be team-disjoint (python -m fv.bench check)",
    "image_tier_bands": {
      "luma_low": 55.0,
      "lap_low": 250.0,
      "luma_mid": 90.0
    },
    "status": "ready = source on the box; pending = not fetched (harness skips it)"
  },
  "team_aliases": {
    "salahds wins scrums": "salahds",
    "salahds win scram": "salahds"
  },
